# Copy this file to ".env" and fill in your real values. Never commit ".env" to Git.

# MongoDB connection string (from MongoDB Atlas). Example:
# mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/notehub
MONGODB_URI=

# Any long random string, used to sign login tokens (JWT). You can generate one
# by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the backend server runs on
PORT=5000

# The URL where your React frontend runs, used for CORS
CLIENT_URL=http://localhost:5173

# AI configuration.
# AI_PROVIDER=mock   -> uses the built-in fake/demo AI (no key needed, works out of the box)
# AI_PROVIDER=openai -> uses a real AI API (requires AI_API_KEY)
AI_PROVIDER=mock
AI_API_KEY=
